@00000000
// Harvard oracle — instruction image (I-mem, read-only, 0-based).
// 64-bit $readmemh elements: each line is two 32-bit instruction words,
//   low 32 bits  = instruction at the byte address,
//   high 32 bits = instruction at +4.
// Code lives here; data lives in dmem.hex (D-mem, separate 0-based
// address space). The program writes its own data at 0x100+ via stores,
// so dmem.hex starts empty. Code 0x00-0x74 (30 instr words); data 0x100+.
//
// RAW-hazard interlock (stall-on-RAW in decode, one bubble) + LSU
// round-trip / byte+halfword sign-zero extend. Same op sequence as the
// von-Neumann program.hex oracle (kept for the VN build via +INIT).
//
// Expected writeback (interlock + LSU working):
//   t0=0x0000000f a0=0x0000005c(92) t5=0x00000001
//   t1=0x0000004d(77) t3=0x00000005  t6=0x00000009
//   t2=0x00000003 t4=0x00000006
//   (no a1=0x42 — branch took the skip)
//   a2=0x00000055 a6=0xffffffab s1=0xffff8000
//   a3=0x00000055 a7=0x000000ab s0=0x00008000 (lhu)
//   a4=0x00000056 s0=0x00008000 (lui)
// One bubble (no wb, no ex) precedes each hazard consumer (a0, t4, the
// bne-resolve path, a4).
//
// Word map (byte addr: instruction):
//   0x00 addi t0,zero,15 | 0x04 csrrw zero,mepc,t0
//   0x08 nop | 0x0c nop
//   0x10 nop | 0x14 nop
//   0x18 nop | 0x1c addi t0,zero,15
//   0x20 addi t1,zero,77 | 0x24 add a0,t0,t1      (RAW t1 -> a0=92)
//   0x28 addi t2,zero,3 | 0x2c div t3,t0,t2       (RAW t2 -> t3=5)
//   0x30 addi t4,t3,1 | 0x34 addi t5,zero,1       (RAW div t3 -> t4=6)
//   0x38 bne t5,zero,+8 | 0x3c addi a1,zero,0x42  (RAW t5 -> taken, skip 0x40)
//   0x40 addi t6,zero,9 | 0x44 addi a2,zero,0x55  (taken-path -> t6=9)
//   0x48 sw a2,0x100(zero) | 0x4c lw a3,0x100(zero)
//   0x50 addi a4,a3,1 | 0x54 addi a5,zero,0xAB    (RAW load a3 -> a4=0x56)
//   0x58 sb a5,0x100(zero) | 0x5c lb a6,0x100(zero)
//   0x60 lbu a7,0x100(zero) | 0x64 lui s0,0x8
//   0x68 sh s0,0x102(zero) | 0x6c lh s1,0x102(zero)
//   0x70 lhu s0,0x102(zero) | 0x74 jal x0,0       (self-loop halt)
