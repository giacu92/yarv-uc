@00000000
// RV32I + M + C program to exercise fetch AND decode. Neither stage past
// decode is implemented, so nothing executes; the encodings just need to
// be valid so the decode log (control + operands + immediates) can be
// matched. One 32-bit hex word per line; the word value IS the encoding
// (low half = rdata[15:0], upper half = rdata[31:16]).
//
// Every encoding below was computed with the RV32I bit-field formula
//   instr = (imm<<..)|(rs2<<20)|(rs1<<15)|(funct3<<12)|(rd<<7)|opcode
// (and the RVC field tables for the compressed forms) and cross-checked
// against the decode log. Decode is validated: it faithfully decodes
// whatever word fetch delivers, so the verification is encoding-vs-log.
//
//   c.li   x1,5     = 0x4095  -> addi x1,x0,5     (rd=1, rs1=0, imm=5, C)
//   c.addi x1,1     = 0x0085  -> addi x1,x1,1     (rd=1, rs1=1, imm=1, C)
//   lui    x2,1     = 0x00001137                (rd=2, imm=0x1000)
//   auipc  x3,2     = 0x00002197                (rd=3, imm=0x2000)
//   addi   x4,x0,7  = 0x00700213                (rd=4, rs1=0, imm=7)
//   mul    x8,x9,x10= 0x02A48433                (M: alu=MUL, rd=8, rs1=9, rs2=10)
//   beq    x0,x0,8  = 0x00000463                (BRANCH BEQ, rs1=0, rs2=0, imm=8)
//   lw     x5,4(x0) = 0x00402283                (LOAD W, rd=5, rs1=0, imm=4)
//   sw     x5,8(x0) = 0x00502423                (STORE W, rs1=0, rs2=5, imm=8)
//   c.mv   x1,x2    = 0x808A  -> add  x1,x0,x2    (rd=1, rs1=0, rs2=2, C)
//   c.add  x1,x2    = 0x908A  -> add  x1,x1,x2    (rd=1, rs1=1, rs2=2, C)
//   c.slli x1,2     = 0x008A  -> slli x1,x1,2     (rd=1, rs1=1, imm=2, C)
//   c.nop           = 0x0001  -> addi x0,x0,0     (rd=0, C)
//   jalr   x0,0(x1) = 0x00008067                (JALR, rd=0, rs1=1, imm=0)
//   c.j    16       = 0xA801  -> jal  x0,16       (branch=JAL, imm=16, C)
//   c.j    0        = 0xA001  -> jal  x0,0        (branch=JAL, imm=0, C)
//   ecall           = 0x00000073                (SYSTEM -> illegal=1)
//   upper 0x0013 in a compressed-low word          (spanning case -> illegal=1)
//
// Word layout (low half decoded first; if low is compressed, upper half
// is held and decoded next cycle at PC=word_pc+2):
//   0x00854095  c.addi x1,1 | c.li x1,5        PC 0  / 2
//   0x00001137  lui x2,1                          PC 4
//   0x00002197  auipc x3,2                        PC 8
//   0x00700213  addi x4,x0,7                       PC 12
//   0x02A48433  mul x8,x9,x10                      PC 16
//   0x00000463  beq x0,x0,8                        PC 20
//   0x00402283  lw x5,4(x0)                        PC 24
//   0x00502423  sw x5,8(x0)                        PC 28
//   0x908A808A  c.add x1,x2 | c.mv x1,x2           PC 32 / 34
//   0x0001008A  c.nop | c.slli x1,2                PC 36 / 38
//   0x00008067  jalr x0,0(x1)                      PC 40
//   0xA001A801  c.j 0 | c.j 16                     PC 44 / 46
//   0x00000073  ecall (illegal)                    PC 48
//   0x00134095  spanning(0x0013) | c.li x1,5        PC 52 (li) / 54 (spanning illegal)
00854095
00001137
00002197
00700213
02A48433
00000463
00402283
00502423
908A808A
0001008A
00008067
A001A801
00000073
00134095